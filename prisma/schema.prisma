generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- IDENTITY ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships  Membership[]
  ticketsCreated Ticket[]      @relation("TicketCreatedBy")
  prsAuthored    PR[]          @relation("PRAuthor")
  reviews        PRReviewer[]
  auditLogs      AuditLog[]
  digests        Digest[]
}

model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships   Membership[]
  tickets       Ticket[]      @relation("TicketOwnerOrg")
  prs           PR[]          @relation("PROwnerOrg")
  auditLogs     AuditLog[]
  featureFlags  FeatureFlag[]

  connectionsA  OrgConnection[] @relation("OrgA")
  connectionsB  OrgConnection[] @relation("OrgB")

  sharedTickets TicketShare[]   @relation("SharedWithOrg")
  sharedPRs     PRShare[]       @relation("SharedWithOrg")
  digests       Digest[]
}

enum Role {
  ORG_ADMIN
  SUPPORT_AGENT
  REVIEWER_APPROVER
  CROSS_ORG_GUEST
  PLATFORM_SUPER_ADMIN
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role

  user User @relation(fields: [userId], references: [id])
  org  Org  @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId]) // one role per user per org
}

model FeatureFlag {
  id      String  @id @default(cuid())
  orgId   String
  key     String
  enabled Boolean @default(true)

  org Org @relation(fields: [orgId], references: [id])

  @@unique([orgId, key])
}

// ---------- CROSS-ORG ----------

enum ConnectionStatus {
  PENDING
  APPROVED
  REVOKED
}

model OrgConnection {
  id        String           @id @default(cuid())
  orgAId    String
  orgBId    String
  status    ConnectionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  orgA Org @relation("OrgA", fields: [orgAId], references: [id])
  orgB Org @relation("OrgB", fields: [orgBId], references: [id])

  @@unique([orgAId, orgBId])
}

// ---------- DASHBOARD 1: TICKETS ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  title       String
  description String
  status      TicketStatus @default(OPEN)
  createdById String
  deletedAt   DateTime?
  attachmentUrl  String?
  attachmentName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Org           @relation("TicketOwnerOrg", fields: [orgId], references: [id])
  createdBy User          @relation("TicketCreatedBy", fields: [createdById], references: [id])
  comments  TicketComment[]
  shares    TicketShare[]
}

// explicit sharing: one ticket -> one partner org at a time
model TicketShare {
  id             String   @id @default(cuid())
  ticketId       String
  sharedWithOrgId String
  createdAt      DateTime @default(now())

  ticket        Ticket @relation(fields: [ticketId], references: [id])
  sharedWithOrg Org    @relation("SharedWithOrg", fields: [sharedWithOrgId], references: [id])

  @@unique([ticketId, sharedWithOrgId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// ---------- DASHBOARD 2: PRs ----------

enum PRStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  MERGED
}

model PR {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String
  status      PRStatus @default(DRAFT)
  authorId    String
  requiredApprovals Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Org          @relation("PROwnerOrg", fields: [orgId], references: [id])
  author    User         @relation("PRAuthor", fields: [authorId], references: [id])
  reviewers PRReviewer[]
  versions  PRVersion[]
  shares    PRShare[]
}

model PRReviewer {
  id       String   @id @default(cuid())
  prId     String
  userId   String
  decision String?  // "approved" | "changes_requested" | null (pending)

  pr   PR   @relation(fields: [prId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([prId, userId])
}

model PRVersion {
  id          String   @id @default(cuid())
  prId        String
  versionNum  Int
  description String
  createdAt   DateTime @default(now())

  pr PR @relation(fields: [prId], references: [id])
}

model PRShare {
  id              String   @id @default(cuid())
  prId            String
  sharedWithOrgId String
  createdAt       DateTime @default(now())

  pr            PR  @relation(fields: [prId], references: [id])
  sharedWithOrg Org @relation("SharedWithOrg", fields: [sharedWithOrgId], references: [id])

  @@unique([prId, sharedWithOrgId])
}

// ---------- AUDIT ----------

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String
  action     String   // e.g. "ticket.created", "pr.approved", "share.granted"
  entityType String   // "Ticket" | "PR" | "OrgConnection" etc.
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  org   Org  @relation(fields: [orgId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
}

model Digest {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  content   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
}